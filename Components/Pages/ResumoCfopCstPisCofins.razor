@page "/dashboard-pis-cofins/cfop-cst/{EmpresaId:int}/{Ano:int}/{Mes:int}"
@rendermode InteractiveServer
@using System.Globalization
@using N3.AnalisadorFiscal.Data.Dashboard
@using N3.AnalisadorFiscal.Data.Repositories
@inject IDashboardPisCofinsRepository Repository
@inject NavigationManager Navigation

<PageTitle>Resumo por CFOP e CST - PIS/COFINS</PageTitle>

<section class="cst-page">
    <div class="page-header">
        <div><span class="eyebrow">@Mes.ToString("00")/@Ano</span><h1>Resumo por CFOP e CST</h1></div>
        <button type="button" class="secondary-button" @onclick="Voltar">Voltar</button>
    </div>

    @if (carregando)
    {
        <div class="message info">Carregando resumo por CFOP e CST...</div>
    }
    else if (!string.IsNullOrWhiteSpace(mensagem))
    {
        <div class="message info">@mensagem</div>
    }
    else
    {
        <section class="summary-grid">
            <div><span class="summary-label">Valor das operações</span><strong>@Moeda(itens.Sum(x => x.ValorOperacao))</strong></div>
            <div><span class="summary-label">CFOPs</span><strong>@itens.Select(x => x.Cfop).Distinct().Count()</strong></div>
            <div><span class="summary-label">Débito PIS</span><strong>@Moeda(DebitoPis)</strong></div>
            <div><span class="summary-label">Crédito PIS</span><strong>@Moeda(CreditoPis)</strong></div>
            <div><span class="summary-label">PIS a pagar</span><strong>@Moeda(PisAPagar)</strong></div>
            <div><span class="summary-label">Débito COFINS</span><strong>@Moeda(DebitoCofins)</strong></div>
            <div><span class="summary-label">Crédito COFINS</span><strong>@Moeda(CreditoCofins)</strong></div>
            <div><span class="summary-label">COFINS a pagar</span><strong>@Moeda(CofinsAPagar)</strong></div>
        </section>

        <div class="cst-table-wrap summary-table-wrap">
            <table class="cst-table summary-table">
                <thead>
                    <tr><th>Operação</th><th class="number">Valor operação</th><th class="number">Base PIS</th><th class="number">PIS</th><th class="number">Base COFINS</th><th class="number">COFINS</th><th class="number">CFOPs</th></tr>
                </thead>
                <tbody>
                    @foreach (var resumo in ResumosOperacao)
                    {
                        <tr>
                            <td><span class="operation-badge @resumo.Classe">@resumo.Nome</span></td>
                            <td class="number">@Moeda(resumo.ValorOperacao)</td>
                            <td class="number">@Moeda(resumo.BasePis)</td>
                            <td class="number highlight">@Moeda(resumo.ValorPis)</td>
                            <td class="number">@Moeda(resumo.BaseCofins)</td>
                            <td class="number highlight">@Moeda(resumo.ValorCofins)</td>
                            <td class="number">@resumo.TotalCfops</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><td colspan="3"><strong>Total (saídas − entradas)</strong></td><td class="number highlight"><strong>@Moeda(SaldoPisItens)</strong></td><td></td><td class="number highlight"><strong>@Moeda(SaldoCofinsItens)</strong></td><td></td></tr>
                    <tr><td colspan="3"><strong>Débitos</strong></td><td class="number highlight"><strong>@Moeda(DebitoPis)</strong></td><td></td><td class="number highlight"><strong>@Moeda(DebitoCofins)</strong></td><td></td></tr>
                    <tr><td colspan="3"><strong>Créditos</strong></td><td class="number highlight"><strong>@Moeda(CreditoPis)</strong></td><td></td><td class="number highlight"><strong>@Moeda(CreditoCofins)</strong></td><td></td></tr>
                    <tr><td colspan="3"><strong>A pagar (apuração M200/M600)</strong></td><td class="number highlight"><strong>@Moeda(PisAPagar)</strong></td><td></td><td class="number highlight"><strong>@Moeda(CofinsAPagar)</strong></td><td></td></tr>
                </tfoot>
            </table>
        </div>

        <div class="cst-table-wrap">
            <table class="cst-table">
                <thead>
                    <tr><th>Operação</th><th>CFOP</th><th>CST PIS</th><th>CST COFINS</th><th class="number">Valor operação</th><th class="number">Base PIS</th><th class="number">PIS</th><th class="number">Base COFINS</th><th class="number">COFINS</th></tr>
                </thead>
                <tbody>
                    @foreach (var grupo in GruposOperacao)
                    {
                        <tr class="group-title-row">
                            <td colspan="9"><span class="operation-badge @grupo.Classe">@grupo.Nome</span></td>
                        </tr>
                        @foreach (var item in grupo.Itens)
                        {
                            <tr>
                                <td>@grupo.Nome.TrimEnd('s')</td>
                                <td><strong>@Exibir(item.Cfop)</strong></td>
                                <td>@Exibir(item.CstPis)</td>
                                <td>@Exibir(item.CstCofins)</td>
                                <td class="number">@Moeda(item.ValorOperacao)</td>
                                <td class="number">@Moeda(item.BasePis)</td>
                                <td class="number highlight">@Moeda(item.ValorPis)</td>
                                <td class="number">@Moeda(item.BaseCofins)</td>
                                <td class="number highlight">@Moeda(item.ValorCofins)</td>
                            </tr>
                        }
                        <tr class="subtotal-row">
                            <td colspan="4"><strong>Subtotal de @grupo.Nome.ToLower(CulturaBrasil)</strong></td>
                            <td class="number"><strong>@Moeda(grupo.Itens.Sum(x => x.ValorOperacao))</strong></td>
                            <td class="number"><strong>@Moeda(grupo.Itens.Sum(x => x.BasePis))</strong></td>
                            <td class="number highlight"><strong>@Moeda(grupo.Itens.Sum(x => x.ValorPis))</strong></td>
                            <td class="number"><strong>@Moeda(grupo.Itens.Sum(x => x.BaseCofins))</strong></td>
                            <td class="number highlight"><strong>@Moeda(grupo.Itens.Sum(x => x.ValorCofins))</strong></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><td colspan="6"><strong>Saldo dos itens (saídas − entradas)</strong></td><td class="number highlight"><strong>@Moeda(SaldoPisItens)</strong></td><td></td><td class="number highlight"><strong>@Moeda(SaldoCofinsItens)</strong></td></tr>
                </tfoot>
            </table>
        </div>
    }
</section>

@code {
    private static readonly CultureInfo CulturaBrasil = new("pt-BR");
    private IReadOnlyList<DashboardPisCofinsCfopCstDto> itens = [];
    private DashboardPisCofinsMesDto? apuracao;
    private bool carregando = true;
    private string? mensagem;
    private IReadOnlyList<ResumoOperacao> ResumosOperacao => [CriarResumo("0", "Entradas", "entry"), CriarResumo("1", "Saídas", "exit")];
    private decimal DebitoPis => apuracao?.DebitoPis ?? 0;
    private decimal CreditoPis => apuracao?.CreditoPis ?? 0;
    private decimal PisAPagar => apuracao?.PisAPagar ?? 0;
    private decimal DebitoCofins => apuracao?.DebitoCofins ?? 0;
    private decimal CreditoCofins => apuracao?.CreditoCofins ?? 0;
    private decimal CofinsAPagar => apuracao?.CofinsAPagar ?? 0;
    private IReadOnlyList<GrupoOperacao> GruposOperacao =>
    [
        CriarGrupo("0", "Entradas", "entry"),
        CriarGrupo("1", "Saídas", "exit")
    ];
    private decimal SaldoPisItens => TotalItens("1", x => x.ValorPis) - TotalItens("0", x => x.ValorPis);
    private decimal SaldoCofinsItens => TotalItens("1", x => x.ValorCofins) - TotalItens("0", x => x.ValorCofins);

    [Parameter] public int EmpresaId { get; set; }
    [Parameter] public int Ano { get; set; }
    [Parameter] public int Mes { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var resumoTask = Repository.GetResumoCfopCstAsync(EmpresaId, Ano, Mes);
            var mesesTask = Repository.GetMesesImportadosAsync(EmpresaId, Ano);
            await Task.WhenAll(resumoTask, mesesTask);
            itens = await resumoTask;
            apuracao = (await mesesTask).FirstOrDefault(x => x.Mes == Mes);
            if (itens.Count == 0) mensagem = "Nenhum item com CFOP e CST encontrado para esta competência.";
        }
        catch (Exception ex) { mensagem = $"Não foi possível carregar o resumo por CFOP e CST: {ex.Message}"; }
        finally { carregando = false; }
    }

    private void Voltar() => Navigation.NavigateTo("/dashboard-pis-cofins");
    private static string Moeda(decimal valor) => valor.ToString("C", CulturaBrasil);
    private static string Exibir(string valor) => string.IsNullOrWhiteSpace(valor) ? "Não informado" : valor;
    private static string Operacao(string indicador) => indicador switch { "0" => "Entrada", "1" => "Saída", _ => "Não informada" };

    private GrupoOperacao CriarGrupo(string indicador, string nome, string classe) =>
        new(nome, classe, itens.Where(x => x.IndicadorOperacao == indicador).ToArray());

    private decimal TotalItens(string indicador, Func<DashboardPisCofinsCfopCstDto, decimal> seletor) =>
        itens.Where(x => x.IndicadorOperacao == indicador).Sum(seletor);

    private ResumoOperacao CriarResumo(string indicador, string nome, string classe)
    {
        var dados = itens.Where(x => x.IndicadorOperacao == indicador).ToArray();
        return new(nome, classe, dados.Sum(x => x.ValorOperacao), dados.Sum(x => x.BasePis),
            dados.Sum(x => x.ValorPis), dados.Sum(x => x.BaseCofins), dados.Sum(x => x.ValorCofins),
            dados.Select(x => x.Cfop).Distinct().Count());
    }

    private sealed record ResumoOperacao(string Nome, string Classe, decimal ValorOperacao,
        decimal BasePis, decimal ValorPis, decimal BaseCofins, decimal ValorCofins, int TotalCfops);
    private sealed record GrupoOperacao(string Nome, string Classe, IReadOnlyList<DashboardPisCofinsCfopCstDto> Itens);
}
